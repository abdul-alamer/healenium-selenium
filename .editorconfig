# Formatting matches the Google Java Style two-space indent used throughout.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100

[*.{gradle,properties}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.feature]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{gradlew,*.sh}]
end_of_line = lf

[gradlew.bat]
end_of_line = crlf
