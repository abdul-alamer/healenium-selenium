# -----------------------------------------------------------------------------
# Example environment file. Copy to `.env` and edit locally:
#
#     cp .env.example .env
#
# `.env` is git-ignored. This file contains placeholder values only - never
# commit real credentials to any of them.
#
# These variables are the third of four configuration layers. Precedence is:
#
#   -D system property  >  environment variable  >  <env>-config.properties
#                                                >  default-config.properties
#
# The variable name for any config key is the key upper-cased with `.` and `-`
# replaced by `_`, e.g. `base-url` -> BASE_URL, `hlm.server.url` -> HLM_SERVER_URL.
# See docs/CONFIGURATION.md for the full table.
# -----------------------------------------------------------------------------

# Which <env>-config.properties overlay to layer on top of default-config.properties.
FRAMEWORK_ENV=local

# --- Application under test --------------------------------------------------
BASE_URL=https://the-internet.herokuapp.com

# --- Browser -----------------------------------------------------------------
# chrome | firefox | edge
BROWSER=chrome
HEADLESS=false
# Leave empty to drive a local browser. Set to a Grid / Selenium container
# endpoint to drive a remote one, e.g. http://localhost:4444/wd/hub
REMOTE_URL=
SELENIUM_WINDOW_WIDTH=1366
SELENIUM_WINDOW_HEIGHT=768

# --- Timeouts (seconds) ------------------------------------------------------
SELENIUM_IMPLICIT_WAIT_TIMEOUT_IN_SECONDS=5
SELENIUM_WEB_DRIVER_WAIT_TIMEOUT_IN_SECONDS=30
SELENIUM_PAGE_LOAD_TIMEOUT_IN_SECONDS=30
SELENIUM_SCRIPT_TIMEOUT_IN_SECONDS=30

# --- Retry / execution -------------------------------------------------------
RETRY_ATTEMPTS=3
RETRY_BACKOFF_IN_MILLIS=200
SCREENSHOT_ON_FAILURE=true

# --- Self-healing (Healenium) -----------------------------------------------
# These four keys are spelled exactly as Healenium spells them, so the framework
# can forward them to Healenium as system properties without a mapping table.
#
# Keep HEAL_ENABLED=false on the pipeline that gates releases. Healing hides
# locator regressions, which is exactly what a release gate must not do.
HEAL_ENABLED=true
HLM_SERVER_URL=http://localhost:7878
HLM_IMITATOR_URL=http://localhost:8000
# How many stored candidate node trees to try per broken locator.
RECOVERY_TRIES=1
# Minimum similarity score (0.0-1.0) a candidate node must reach to be accepted.
SCORE_CAP=0.5

# --- Reporting ---------------------------------------------------------------
ALLURE_RESULTS_DIR=build/allure-results
HEALING_REPORT_DIR=build/healenium/report
